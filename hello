-- ---------- Diagnose (Clipboard-Trace, nach Test pasten) ----------
local DIAG = {}
local function diag(s) table.insert(DIAG, s) end
diag("v1 start")

-- ---------- Config ----------
local MY_PLOT = "7"
local AREA_SCORE = {
    Forest = 1, Lake = 2, Desert = 3, Jungle = 4, Snow = 5,
    Volcano = 6, ["Abyss Ocean"] = 7, AbyssOcean = 7, Prehistoric = 8,
    Cosmic = 9, ["Cherry Blossom"] = 10, CherryBlossom = 10,
    ["Titan Temple"] = 11, TitanTemple = 11,
    ["Angels vs Demons"] = 12, AngelsVsDemons = 12,
    ["Light Dark"] = 12, LightDark = 12,
}

-- ---------- Remotes ----------
local function net(kind, path)
    local ok, r = pcall(function()
        return RS.Packages.Networking[kind .. "/" .. path]
    end)
    if ok and r then return r end
    warn("[sae] remote fehlt: " .. kind .. "/" .. path)
    return nil
end
local R = {}
function R.init()
    R.Snap   = net("RF", "EggWorld/AskFieldEggSnapshot")
    R.Live   = net("RF", "EggWorld/AskLiveSnapshot")
    R.Place  = net("RF", "EggWorld/AskPlaceEgg")
    R.Hatch  = net("RF", "EggWorld/AskHatch")
    R.Finish = net("RF", "EggWorld/AskFinishHatch")
    R.WearBest = net("RF", "Haul/WearBest")
    R.CodexAll = net("RF", "Codex/AskRedeemAll")
end

-- ---------- Helfer ----------
local function hrp()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end
local function hum()
    local c = lp.Character
    return c and c:FindFirstChildOfClass("Humanoid") or nil
end
local function moveTo(pos, timeout)
    local h, r = hum(), hrp()
    if not (h and r) then return false end
    h:MoveTo(pos)
    local t0 = os.clock()
    while os.clock() - t0 < (timeout or 15) do
        if not (h and r and r.Parent) then return false end
        if (r.Position - pos).Magnitude < 6 then return true end
        task.wait(0.3)
    end
    return false
end
local function equippedUid()
    local c = lp.Character
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("ItemType") == "AssetEgg" then
                return t:GetAttribute("UID")
            end
        end
    end
    return nil
end
local function plotSlots()
    local out = {}
    local plots = workspace:FindFirstChild("Plots")
    local plot = plots and plots:FindFirstChild(MY_PLOT)
    local pen = plot and plot:FindFirstChild("ToUpdate")
    pen = pen and pen:FindFirstChild("StarterPen")
    if pen then
        for _, n in ipairs({"Prompt1", "Prompt2", "Prompt3"}) do
            local p = pen:FindFirstChild(n)
            if p and p:IsA("BasePart") then
                table.insert(out, p.CFrame)
            end
        end
    end
    return out
end

-- ---------- Auto-Steal ----------
local stealOn = false
local function bestEgg()
    local ok, res = pcall(function() return R.Snap:InvokeServer() end)
    if not (ok and typeof(res) == "table" and typeof(res.Records) == "table") then
        return nil
    end
    local best, bestS = nil, -1
    for _, r in ipairs(res.Records) do
        if typeof(r) == "table" and r.State == "Slot"
            and r.BottomCFrame and typeof(r.BottomCFrame) == "CFrame" then
            local s = (AREA_SCORE[tostring(r.AreaId)] or 0) * 1000
                + (tonumber(r.AssetScale) or 0) * 10
            if r.HasParasite then s = s + 5000 end
            if s > bestS then best, bestS = r, s end
        end
    end
    return best
end
local function deliverEquipped()
    -- abliefern: Slots durchprobieren (Erfolg = Tool weg)
    local uid = equippedUid()
    if uid then
        for _, cf in ipairs(plotSlots()) do
            pcall(function()
                return R.Place:InvokeServer({ Uid = uid, LocalCFrame = cf })
            end)
            task.wait(1)
            if not equippedUid() then break end
        end
    end
end
local function stealTick()
    if equippedUid() then deliverEquipped() return end -- getragen -> abliefern!
    local rec = bestEgg()
    if not rec then return end
    local pos = rec.BottomCFrame.Position
    if not moveTo(pos + Vector3.new(0, 2, 0)) then return end
    -- naechsten aktiven Prompt feuern (= Tipp-Button)
    local bp, bd = nil, 1e9
    local r = hrp()
    if not r then return end
    for _, c in ipairs(workspace:GetChildren()) do
        if c.Name == "SmartPromptPart" and c:IsA("BasePart") then
            local p = c:FindFirstChildOfClass("ProximityPrompt")
            if p and p.Enabled then
                local d = (r.Position - c.Position).Magnitude
                if d < bd then bp, bd = p, d end
            end
        end
    end
    if not (bp and bd <= 7) then return end
    pcall(function() fireproximityprompt(bp) end)
    task.wait(1)
    deliverEquipped()
end

-- ---------- Auto-Hatch ----------
local hatchOn = false
local function hatchTick()
    local me = tostring(lp.UserId)
    local ok, res = pcall(function() return R.Live:InvokeServer() end)
    if ok and typeof(res) == "table" then
        for _, grp in pairs(res) do
            if typeof(grp) == "table" and tostring(grp.OwnerUserId) == me
                and typeof(grp.Records) == "table" then
                for k in pairs(grp.Records) do
                    local key = tostring(k)
                    local okH, rH = pcall(function()
                        return R.Hatch:InvokeServer(key)
                    end)
                    if okH and rH then
                        pcall(function() return R.Finish:InvokeServer(key) end)
                    end
                    task.wait(0.3)
                end
            end
        end
    end
    pcall(function() return R.WearBest:InvokeServer() end)
    pcall(function() return R.CodexAll:InvokeServer() end)
end

-- ---------- ESP (nur wenn Drawing da) ----------
local espOn = false
local espDraws = {}
local hasDrawing = typeof(Drawing) == "table"
local function espClear()
    for _, d in pairs(espDraws) do pcall(function() d:Remove() end) end
    espDraws = {}
end
local function espTick()
    espClear()
    if not hasDrawing then return end
    local cam = workspace.CurrentCamera
    local ok, res = pcall(function() return R.Snap:InvokeServer() end)
    if not (cam and ok and typeof(res) == "table" and typeof(res.Records) == "table") then
        return
    end
    local r0 = hrp()
    local myPos = r0 and r0.Position or nil
    local i = 0
    for _, r in ipairs(res.Records) do
        if typeof(r) == "table" and r.State == "Slot"
            and r.BottomCFrame and typeof(r.BottomCFrame) == "CFrame" then
            local pos = r.BottomCFrame.Position
            local v, on = cam:WorldToViewportPoint(pos + Vector3.new(0, 3, 0))
            if on then
                i = i + 1
                if i > 40 then break end
                local dist = myPos and (math.floor((myPos - pos).Magnitude) .. "m") or "?"
                local ok2, t = pcall(function()
                    local x = Drawing.new("Text")
                    x.Text = string.format("%s|%s|x%.1f%s|%s",
                        tostring(r.AssetCategory or "?"), tostring(r.AreaId or "?"),
                        tonumber(r.AssetScale) or 0,
                        r.HasParasite and "|PARASIT" or "", dist)
                    x.Size = 14 x.Center = true x.Outline = true
                    x.Color = r.HasParasite and Color3.fromRGB(200, 80, 255)
                        or Color3.fromRGB(120, 255, 120)
                    x.Position = Vector2.new(v.X, v.Y) x.Visible = true
                    return x
                end)
                if ok2 and t then espDraws[i] = t end
            end
        end
    end
end

-- ---------- Loops ----------
task.spawn(function()
    while true do
        if stealOn then pcall(stealTick) end
        task.wait(1.5)
    end
end)
task.spawn(function()
    while true do
        if hatchOn then pcall(hatchTick) end
        task.wait(30)
    end
end)
task.spawn(function()
    while true do
        if espOn then pcall(espTick) else espClear() end
        task.wait(0.5)
    end
end)

