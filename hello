local function btn(name, y, cb, init)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 150, 0, 34)
    b.Position = UDim2.new(0, 12, 0, y) -- LINKS (rechts verdeckt Deltas Menue)
    b.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    b.TextColor3 = Color3.white
    b.TextSize = 15
    b.Font = Enum.Font.GothamBold
    local st = init or false
    local function paint()
        b.Text = name .. (st and ": AN" or ": AUS")
        b.BackgroundColor3 = st and Color3.fromRGB(30, 140, 70)
            or Color3.fromRGB(20, 20, 28)
    end
    paint()
    b.MouseButton1Click:Connect(function()
        st = not st paint() cb(st)
    end)
    b.Parent = gui
    return b
end
btn("Steal", 120, function(v) stealOn = v end)
btn("ESP" .. (hasDrawing and "" or " (n/a)"), 160, function(v) espOn = v and hasDrawing end)
