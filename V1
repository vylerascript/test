-- ---------- ESP (BillboardGui, Top-3-pro-Area, stale-sicher) ----------
local espGui = nil
local espEmptyTicks = 0
local function espScore(r)
    local s = 0
    if RARE_NAMES[tostring(r.AssetCategory)] then s = s + 20000 end
    if r.HasParasite then s = s + 5000 end
    return s
end
local function espTick()
    local recs = snap()
    if not recs then return end -- FEHLER: alte Labels behalten!
    -- pro Area (NUR Top 6, fest): ALLE freien Eggs (jede Groesse),
    -- Beste markiert:
    local perArea = {}
    for _, r in ipairs(recs) do
        if typeof(r) == "table" and r.State == "Slot" then
            local a = tostring(r.AreaId or "?")
            if TOP_AREAS[normArea(a)] then
                perArea[a] = perArea[a] or {}
                table.insert(perArea[a], r)
            end
        end
    end
    local want = {} -- Uid -> rec (alle Top-6)
    for _, list in pairs(perArea) do
        for _, r in ipairs(list) do
            if r.Uid then want[tostring(r.Uid)] = r end
            if r.NestId then want["N:" .. tostring(r.NestId)] = r end
        end
    end
    local r0 = hrp()
    local myPos = r0 and r0.Position or nil
    local slots = workspace:FindFirstChild("AreaEggSlotsClient")
    if not slots then return end
    local parent = nil
    pcall(function()
        if typeof(gethui) == "function" then parent = gethui() end
    end)
    if not parent then parent = lp.PlayerGui end
    -- neu bauen, erst bei Erfolg tauschen:
    local g = Instance.new("ScreenGui")
    g.Name = "SAEESP"
    local okBuild = pcall(function() g.Parent = parent end)
    if not okBuild then return end
    local n = 0
    -- Slot-Positionen indexieren (einmal pro Tick):
    local slotList = {}
    for _, s in ipairs(slots:GetChildren()) do
        local anchor = s:FindFirstChild("Hitbox")
            or s:FindFirstChildWhichIsA("BasePart")
        if anchor then
            table.insert(slotList, { s = s, pos = anchor.Position,
                anchor = anchor })
        end
    end
    -- Records per POSITION zuordnen (naechster freier Slot < 25m):
    -- Namen sind je Area anders (Suffix vs. Hex), Position luegt nie.
    local usedSlot = {}
    local matchList = {}
    for _, r in ipairs(recs) do
        if typeof(r) == "table" and r.State == "Slot"
            and r.BottomCFrame and typeof(r.BottomCFrame) == "CFrame"
            and TOP_AREAS[normArea(r.AreaId)] then
            local rp = r.BottomCFrame.Position
            local bi, bd = 0, 25
            for i, sl in ipairs(slotList) do
                if not usedSlot[i] then
                    local d = (sl.pos - rp).Magnitude
                    if d < bd then bi, bd = i, d end
                end
            end
            if bi > 0 then
                usedSlot[bi] = true
                table.insert(matchList, { rec = r, slot = slotList[bi] })
            end
        end
    end
    -- pro Top-6-Area NUR das beste (Rare/Parasit zuerst).
    -- Score 0 (Commons) kommt gar nicht erst rein:
    local bestPerArea = {}
    for _, pr in ipairs(matchList) do
        local a = tostring(pr.rec.AreaId or "?")
        local sc = 0
        if RARE_NAMES[tostring(pr.rec.AssetCategory)] then sc = sc + 20000 end
        if pr.rec.HasParasite then sc = sc + 5000 end
        if sc > 0 and (not bestPerArea[a] or sc > bestPerArea[a].sc) then
            bestPerArea[a] = { pr = pr, sc = sc }
        end
    end
    for _, bp in pairs(bestPerArea) do
        local pr = bp.pr
        local rec, s, anchor = pr.rec, pr.slot.s, pr.slot.anchor
            -- Bestes Ei der Area, Beste markiert:
            local label, col = nil, Color3.fromRGB(130, 255, 130)
            local isBest = RARE_NAMES[tostring(rec.AssetCategory)] == true
                or rec.HasParasite == true
            if true then
                local sc = tonumber(rec.AssetScale) or 0
                local cls = sc >= 3 and "XL" or sc >= 2 and "L"
                    or sc >= 1 and "M" or "S"
                local dist = "?"
                local hb = s:FindFirstChild("Hitbox")
                if myPos and hb then
                    dist = math.floor((myPos - hb.Position).Magnitude) .. "m"
                end
                label = string.format("%s|%s|x%.2f[%s]%s%s|%s",
                    tostring(rec.AssetCategory or "?"),
                    tostring(rec.AreaId or "?"), sc, cls,
                    rec.HasParasite and "|EVENT" or "",
                    RARE_NAMES[tostring(rec.AssetCategory)] and "|BEST" or "",
                    dist)
                if rec.HasParasite then
                    col = Color3.fromRGB(220, 130, 255)
                elseif RARE_NAMES[tostring(rec.AssetCategory)] then
                    col = Color3.fromRGB(120, 200, 255) -- Beste blau
                elseif sc >= 2 then
                    col = Color3.fromRGB(255, 210, 80) -- Riesen gold
                end
            end
            local anchor = s:FindFirstChild("Hitbox")
                or s:FindFirstChildWhichIsA("BasePart")
            if label and anchor then
                n = n + 1
                if n > 60 then break end
                pcall(function()
                    local bb = Instance.new("BillboardGui")
                    bb.Size = UDim2.new(0, 200, 0, 26)
                    bb.StudsOffset = Vector3.new(0, 4, 0)
                    bb.AlwaysOnTop = true
                    bb.Adornee = anchor
                    local tl = Instance.new("TextLabel")
                    tl.Size = UDim2.new(1, 0, 1, 0)
                    tl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    tl.BackgroundTransparency = 0.3
                    tl.TextColor3 = col
                    tl.TextSize = 13
                    tl.Text = label
                    tl.Parent = bb
                    bb.Parent = g
                end)
            end
        end
    -- Tausch-Regel: neu wenn Labels da; leer nur bei leerem Snapshot
    -- (Lockout) oder 5x leer in Folge (Stale-Schutz, kein Toggle nötig):
    local recCount = #matchList
    espStatus = "ESP: " .. n .. " Labels (" .. recCount .. " Top)"
    if n > 0 then
        espEmptyTicks = 0
        if espGui then pcall(function() espGui:Destroy() end) end
        espGui = g
    elseif recCount == 0 then
        espEmptyTicks = 0
        if espGui then pcall(function() espGui:Destroy() end) end
        espGui = g
    else
        espEmptyTicks = espEmptyTicks + 1
        if espEmptyTicks >= 5 then
            espEmptyTicks = 0
            if espGui then pcall(function() espGui:Destroy() end) end
            espGui = g
        end
    end
end
local function espClear()
    if espGui then pcall(function() espGui:Destroy() end) end
    espGui = nil
end
local function hatchTick()
    local me = tostring(lp.UserId)
    local ok, res = pcall(function() return R.Live:InvokeServer() end)
    if ok and typeof(res) == "table" then
        for _, grp in pairs(res) do
            if typeof(grp) == "table" and tostring(grp.OwnerUserId) == me
                and typeof(grp.Records) == "table" then
                for k in pairs(grp.Records) do
                    local key = tostring(k)
                    local okH, rH = pcall(function()
                        return R.Hatch:InvokeServer(key)
                    end)
                    if okH and rH then
                        pcall(function() return R.Finish:InvokeServer(key) end)
                    end
                    task.wait(0.3)
                end
            end
        end
    end
    pcall(function() return R.WearBest:InvokeServer() end)
    pcall(function() return R.CodexAll:InvokeServer() end)
end

-- ---------- Steal ----------
local function deliverEquipped()
    local uid = equippedUid()
    if uid then
        for _, cf in ipairs(plotSlots()) do
            pcall(function()
                return R.Place:InvokeServer({ Uid = uid, LocalCFrame = cf })
            end)
            task.wait(1)
            if not equippedUid() then break end
        end
    end
end
local function stealTick()
    if equippedUid() then
        stealStatus = "liefere ab..."
        deliverEquipped()
        return
    end
    stealStatus = "suche Egg..."
    local recs = snap()
    if not recs then stealStatus = "kein Snapshot!" return end
    local freeN, totalN = 0, 0
    local best, bestS = nil, -1
    for _, r in ipairs(recs) do
        if typeof(r) == "table" then
            totalN = totalN + 1
            if r.State == "Slot" then
                freeN = freeN + 1
                if r.BottomCFrame and typeof(r.BottomCFrame) == "CFrame"
                    and areaOk(r)
                    and bestOk(r)
                    and (tonumber(r.AssetScale) or 0) >= S.minScale
                    and (not S.parasiteOnly or r.HasParasite) then
                    -- Score OHNE Groesse: Area + Seltenheit (Beste = selten)
                    local s = (AREA_SCORE[tostring(r.AreaId)] or 0) * 1000
                    if S.rareBoost and RARE_NAMES[tostring(r.AssetCategory)] then
                        s = s + 20000
                    end
                    if r.HasParasite then s = s + 5000 end
                    if s > bestS then best, bestS = r, s end
                end
            end
        end
    end
    if not best then
        stealStatus = "frei " .. freeN .. "/" .. totalN .. " Filter!"
        return
    end
    local pos = best.BottomCFrame.Position
    local r0 = hrp()
    local d0 = r0 and math.floor((r0.Position - pos).Magnitude) or -1
    stealStatus = "laufe " .. d0 .. "m " .. tostring(best.AssetCategory)
    if not moveTo(pos + Vector3.new(0, 2, 0), 25) then
        stealStatus = "Weg blockiert!"
        return
    end
    stealStatus = "nehme Egg..."
    local r1 = hrp()
    if not r1 then return end
    local bp, bd = nil, 1e9
    for _, c in ipairs(workspace:GetChildren()) do
        if c.Name == "SmartPromptPart" and c:IsA("BasePart") then
            local p = c:FindFirstChildOfClass("ProximityPrompt")
            if p and p.Enabled then
                local d = (r1.Position - c.Position).Magnitude
                if d < bd then bp, bd = p, d end
            end
        end
    end
    if not (bp and bd <= 7) then
        stealStatus = "Prompt " .. math.floor(bd) .. "m weg!"
        return
    end
    pcall(function() fireproximityprompt(bp) end)
    task.wait(1)
    if equippedUid() then
        stealStatus = "Egg! -> Plot " .. MY_PLOT
    else
        stealStatus = "Pickup FAIL"
        return
    end
    deliverEquipped()
    stealStatus = "fertig!"
end

