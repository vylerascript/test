-- ---------- Remotes (lazy) ----------
local R = nil
local function ensureR()
    if R then return true end
    R = {}
    local ok = pcall(function()
        local N = RS.Packages.Networking
        R.Snap   = N["RF/EggWorld/AskFieldEggSnapshot"]
        R.Live   = N["RF/EggWorld/AskLiveSnapshot"]
        R.Place  = N["RF/EggWorld/AskPlaceEgg"]
        R.Hatch  = N["RF/EggWorld/AskHatch"]
        R.Finish = N["RF/EggWorld/AskFinishHatch"]
        R.WearBest = N["Haul/WearBest"]
        R.CodexAll = N["Codex/AskRedeemAll"]
    end)
    return ok and R.Snap ~= nil
end

-- ---------- Helfer ----------
local function hrp()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end
local function moveTo(pos, timeout)
    local c = lp.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local r = hrp()
    if not (h and r) then return false end
    h:MoveTo(pos)
    local t0 = os.clock()
    while os.clock() - t0 < (timeout or 20) do
        if (r.Position - pos).Magnitude < 6 then return true end
        task.wait(0.3)
    end
    return false
end
local function equippedUid()
    local c = lp.Character
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("ItemType") == "AssetEgg" then
                return t:GetAttribute("UID")
            end
        end
    end
    return nil
end
local function plotSlots()
    local out = {}
    local plots = workspace:FindFirstChild("Plots")
    local plot = plots and plots:FindFirstChild(MY_PLOT)
    local pen = plot and plot:FindFirstChild("ToUpdate")
    pen = pen and pen:FindFirstChild("StarterPen")
    if pen then
        for _, n in ipairs({"Prompt1", "Prompt2", "Prompt3"}) do
            local p = pen:FindFirstChild(n)
            if p and p:IsA("BasePart") then
                table.insert(out, p.CFrame)
            end
        end
    end
    return out
end
local function snap()
    local ok, res = pcall(function() return R.Snap:InvokeServer() end)
    if ok and typeof(res) == "table"
        and typeof(res.Records) == "table" then
        return res.Records
    end
    return nil
end
-- Besten-Filter (nur Steal, ESP zeigt weiter alles):
local function bestOk(rec)
    local f = S.bestFilter
    if f == "Alle" then return true end
    local sc = tonumber(rec.AssetScale) or 0
    if f == "Riesen (x2+)" then return sc >= 2 end
    if f == "XL (x3+)" then return sc >= 3 end
    if f == "Rare Namen" then
        return RARE_NAMES[tostring(rec.AssetCategory)] == true
    end
    if f == "Beste (selten)" then
        return RARE_NAMES[tostring(rec.AssetCategory)] == true
            or rec.HasParasite == true
    end
    if f == "Event Eggs" then return rec.HasParasite == true end
    return true
end
local function areaOk(rec)
    if S.stealArea == "Alle" then return true end
    local a = tostring(rec.AreaId or "")
    return a == S.stealArea
        or string.gsub(a, "%s+", "") == string.gsub(S.stealArea, "%s+", "")
end

