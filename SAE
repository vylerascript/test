-- ── CAR LOOT AUTOFARM ────────────────────────────────────────────────────────
-- spoof: tween root into car seat CFrame so server sees us seated/overlapping
-- then fire the loot remote; never raw-teleport (detected)

local function find_lootable_cars()
    local cars = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        -- seat / VehicleSeat inside a car model that has a loot prompt or value
        if obj:IsA("VehicleSeat") or
           (obj:IsA("Model") and (
               obj.Name:lower():find("car")   or
               obj.Name:lower():find("vehicle") or
               obj.Name:lower():find("auto")
           )) then
            table.insert(cars, obj)
        end
    end
    return cars
end

local function find_loot_remote()
    -- walk ReplicatedStorage for any RemoteEvent/Function whose name hints loot/money/rob
    local RS = game:GetService("ReplicatedStorage")
    for _, v in ipairs(RS:GetDescendants()) do
        if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) and (
            v.Name:lower():find("loot")   or
            v.Name:lower():find("rob")    or
            v.Name:lower():find("money")  or
            v.Name:lower():find("steal")  or
            v.Name:lower():find("cash")   or
            v.Name:lower():find("collect")
        ) then
            return v
        end
    end
    return nil
end

local function tween_to(target_cf, duration)
    local root = get_root(); if not root then return end
    -- unanchor temporarily so tween moves us
    local was_anchored = root.Anchored
    root.Anchored = false
    local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        CFrame = target_cf
    })
    tw:Play()
    tw.Completed:Wait()
    root.Anchored = was_anchored
end

local function spoof_in_car(seat)
    -- sit into seat via Sit() — server sees us in vehicle
    local hum = get_hum(); if not hum then return end
    if seat:IsA("VehicleSeat") or seat:IsA("Seat") then
        seat:Sit(hum)
        task.wait(0.3)
    end
end

local function do_car_loot()
    local root = get_root(); if not root then return end
    local remote = find_loot_remote()
    local cars   = find_lootable_cars()

    for _, car in ipairs(cars) do
        if not cfg.autofarm then break end

        local seat = nil
        if car:IsA("VehicleSeat") or car:IsA("Seat") then
            seat = car
        else
            seat = car:FindFirstChildOfClass("VehicleSeat")
                or car:FindFirstChildOfClass("Seat")
        end

        if seat then
            -- tween close to car (not teleport — avoids noclip detect)
            local target = seat.CFrame * CFrame.new(0, 2, 0)
            tween_to(target, 0.4)

            -- spoof sit
            spoof_in_car(seat)

            -- fire any prox prompts inside the car
            for _, pp in ipairs(seat.Parent and seat.Parent:GetDescendants() or {}) do
                if pp:IsA("ProximityPrompt") then
                    pcall(function() fireproximityprompt(pp) end)
                end
            end

            -- fire loot remote if found, pass car/seat as arg
            if remote then
                if remote:IsA("RemoteEvent") then
                    pcall(function() remote:FireServer(seat.Parent or seat) end)
                elseif remote:IsA("RemoteFunction") then
                    pcall(function() remote:InvokeServer(seat.Parent or seat) end)
                end
            end

            task.wait(0.6)

            -- unsit
            local hum = get_hum()
            if hum then hum.Sit = false end
        end

        -- fire any money pickups nearby after loot
        for _, pp in ipairs(Workspace:GetDescendants()) do
            if pp:IsA("ProximityPrompt") then
                local part = pp.Parent
                if part and part:IsA("BasePart") then
                    local d = (root.Position - part.Position).Magnitude
                    if d < 30 then
                        pcall(function() fireproximityprompt(pp) end)
                    end
                end
            end
        end

        task.wait(0.5)
    end
end

connections["farm_loop"] = RunService.Heartbeat:Connect(function()
    if cfg.autofarm then
        task.spawn(do_car_loot)
        task.wait(3) -- throttle full cycle to every ~3s
    end
end)

-- ── INVIS — network-side ─────────────────────────────────────────────────────
-- sets every part's network owner + destroys render on OTHER clients via
-- LocalTransparencyModifier is client-only, so we use a tool trick:
-- replicate transparency via a RemoteEvent if available, else hide via
-- forcefield flicker + part transparency on server through a tool fire
-- Most reliable executor method: set transparency on server via a known remote
-- or use the "hide from others" seat trick. Here we use both layers.

local invis_conn = nil

local function set_invis_local(state)
    -- layer 1: hide from own screen
    local c = get_char(); if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            p.LocalTransparencyModifier = state and 1 or 0
        end
    end
end

local function set_invis_network(state)
    -- layer 2: set actual part Transparency so other clients see it
    -- requires executor with setflag / set property on server-replicated parts
    -- works on most executors that allow property sets on non-owned parts
    local c = get_char(); if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            pcall(function() p.Transparency = state and 1 or 0 end)
        end
    end
    -- also hide accessories / hat handles
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("SpecialMesh") or p:IsA("Decal") then
            pcall(function() p.Transparency = state and 1 or 0 end)
        end
    end
    -- humanoid display
    local hum = get_hum()
    if hum then
        pcall(function()
            hum.DisplayDistanceType = state
                and Enum.HumanoidDisplayDistanceType.None
                or  Enum.HumanoidDisplayDistanceType.Viewer
        end)
    end
end

local function apply_invis(state)
    set_invis_local(state)
    set_invis_network(state)
end

connections["invis_respawn"] = lp.CharacterAdded:Connect(function()
    task.wait(1)
    if cfg.invis then apply_invis(true) end
end)

-- ── GODMODE — server-replicated ───────────────────────────────────────────────
-- method 1: hook humanoid HealthChanged and reset via remote if available
-- method 2: kill the TakeDamage function on our humanoid
-- method 3: freeze HP via a tight heartbeat write
-- all three stacked

local function hook_godmode()
    local hum = get_hum(); if not hum then return end

    -- method A: override TakeDamage
    local old_td = hum.TakeDamage
    hum.TakeDamage = function(self, amount)
        if cfg.godmode then return end
        return old_td(self, amount)
    end

    -- method B: HealthChanged → restore
    connections["gm_health"] = hum.HealthChanged:Connect(function(hp)
        if cfg.godmode and hp < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end)

    -- method C: tight heartbeat lock
    connections["gm_beat"] = RunService.Heartbeat:Connect(function()
        if not cfg.godmode then return end
        local h = get_hum()
        if h and h.Health < h.MaxHealth then
            pcall(function() h.Health = h.MaxHealth end)
        end
    end)
end

hook_godmode()

connections["gm_respawn"] = lp.CharacterAdded:Connect(function()
    task.wait(0.5)
    hook_godmode()
end)

