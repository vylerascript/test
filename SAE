local function world_to_vp(pos)
    local s, on = cam:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), on
end

-- ── SILENT AIM ───────────────────────────────────────────────────────────────
local function best_target()
    local cx = cam.ViewportSize.X / 2
    local cy = cam.ViewportSize.Y / 2
    local center = Vector2.new(cx, cy)
    local best_d, best_p = cfg.silent_fov, nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local head = get_head(plr)
            local hum  = get_hum_p(plr)
            if head and hum and hum.Health > 0 then
                local s, on = world_to_vp(head.Position)
                if on then
                    local d = (s - center).Magnitude
                    if d < best_d then best_d = d; best_p = plr end
                end
            end
        end
    end
    return best_p
end

local mt = getrawmetatable and getrawmetatable(mouse)
local orig_index
if mt then
    setreadonly(mt, false)
    orig_index = mt.__index
    mt.__index = function(self, key)
        if cfg.silent_aim and (key == "Hit" or key == "Target") then
            local t = best_target()
            if t then
                local h = get_head(t)
                if h then
                    if key == "Hit"    then return CFrame.new(h.Position) end
                    if key == "Target" then return h end
                end
            end
        end
        return orig_index(self, key)
    end
end

