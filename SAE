            Position = on and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)
        }):Play()
    end

    R.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            cfg[key] = not cfg[key]
            refresh()
            if cb then cb(cfg[key]) end
