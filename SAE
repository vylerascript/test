                        local h0 = farmHost(c)
                        local p0 = h0 and h0.Position or nil
                        if p0 then
                            local dd = (myP0 - p0).Magnitude
                            if dd < bestD then pr, bestD = c, dd end
                        end
                    end
                end
            end)
        end
    end
    if not pr then return end
    tapLog("Ghost", "fahre " .. math.floor(bestD) .. "m")
    -- Diagnose: näheres Auto übersprungen? Grund zeigen
    pcall(function()
        local hrp0 = myHRP()
        local myP0 = hrp0 and hrp0.Position or nil
        if myP0 then
            for _, c in ipairs(ghostSpots) do
                if c ~= pr then
                    local dd = nil
                    pcall(function()
                        if c.Parent ~= nil then
                            local h0 = farmHost(c)
                            local p0 = h0 and h0.Position or nil
                            if p0 then dd = (myP0 - p0).Magnitude end
                        end
                    end)
                    if dd and dd < bestD - 5 then
                        local left = (ghostDone[c] or 0) - os.clock()
                        local why = "?"
                        if left > 0 then
                            why = "Pause " .. math.floor(left) .. "s"
                        else
                            local en = true
                            pcall(function() en = c.Enabled end)
                            why = en and "Glas weg?" or "Prompt aus"
                        end
                        tapLog("Ghost", "nah (" .. math.floor(dd) .. "m) skip: " .. why)
                        break
                    end
                end
            end
        end
    end)
    local okPr = pcall(function() return pr.Parent ~= nil end)
    if not okPr then return end
    local host = farmHost(pr)
    local pos = host and host.Position or nil
    if not pos then return end
    -- Cooldown-Check: Prompt aktiv + Glas noch heile, sonst skip (5 Min)
    local live, glassOk = false, false
    pcall(function() live = pr.Enabled end)
    if live then
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("BasePart") then
                local ln = string.lower(d.Name)
                if string.find(ln, "window", 1, true) or string.find(ln, "glass", 1, true) or string.find(ln, "windshield", 1, true) then
                    if (pos - d.Position).Magnitude <= 14 then glassOk = true break end
                end
            end
        end
    end
    if not (live and glassOk) then
        ghostDone[pr] = os.clock() + 180
        ghostSkips = ghostSkips + 1
        if ghostSkips >= 3 then
            ghostSkips = 0
            ghostPauseUntil = os.clock() + 60
            tapLog("Ghost", "nur CD-Autos! 60s Pause")
        else
            tapLog("Ghost", "Auto Cooldown, weiter")
        end
        return
    end
    -- HIN-TP (Fahrzeug, 12s-Takt safe per Cadence-Test: 10s/20s = 0 Backs)
    do
        local dt = os.clock() - (ghostLastTP or 0)
        if dt < 12 then task.wait(12 - dt) end
    end
    -- Landeplatz VORHER prüfen: erst seitlich ans Fenster, sonst alte Suche (Fallback nie blind!)
    local land = nil
    pcall(function() land = ghostSideLanding(m, pr, pos) end)
    if not land then
        pcall(function() land = ghostLanding(pos, { lp.Character, m }) end)
    end
    local landOk = false
    pcall(function()
        if land then landOk = spotClear(m, land) end
    end)
    if not landOk then
        ghostDone[pr] = os.clock() + 60
        tapLog("Ghost", "kein Landeplatz, weiter")
        return
    end
    pcall(function()
        m:PivotTo(CFrame.new(land))
    end)
    -- exakt auf Boden setzen (kein Schweben!): Unterkante auf Boden+0.2
    pcall(function()
        local cf, sz = m:GetBoundingBox()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { lp.Character, m }
        params.IgnoreWater = true
        local hit = Workspace:Raycast(cf.Position + Vector3.new(0, 2, 0), Vector3.new(0, -20, 0), params)
        if hit and hit.Position then
            local bottomNow = cf.Position.Y - sz.Y / 2
            m:PivotTo(cf + Vector3.new(0, (hit.Position.Y + 0.2) - bottomNow, 0))
        end
    end)
    -- Rollbremse: Speed sofort + laufend killen (kein Anker!)
    local function brakeScoot()
        pcall(function()
            for _, d in ipairs(m:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.AssemblyLinearVelocity = Vector3.zero
                    d.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    end
    brakeScoot()
    ghostLastTP = os.clock()
    task.wait(0.7)
    -- Ankunft prüfen (20m), sonst 1x neu TPn, sonst skip
    local there = false
    pcall(function()
        local cf = m:GetBoundingBox()
        if (cf.Position - pos).Magnitude <= 20 then there = true end
    end)
    if not there then
        local land2 = nil
        pcall(function() land2 = ghostLanding(pos, { lp.Character, m }) end)
        local ok2 = false
        pcall(function() if land2 then ok2 = spotClear(m, land2) end end)
        if ok2 then
            pcall(function()
                m:PivotTo(CFrame.new(land2))
            end)
            task.wait(0.7)
        end
        pcall(function()
            local cf = m:GetBoundingBox()
            if (cf.Position - pos).Magnitude <= 20 then there = true end
        end)
    end
    if not there then
        ghostDone[pr] = os.clock() + 60
        tapLog("Ghost", "TP daneben, weiter")
        return
    end
    -- Freiraum? (nicht im Dach): sonst 3m weg versetzen, sonst skip
    local function clearNow()
        local okc = false
        pcall(function()
            local cf = m:GetBoundingBox()
            okc = spotClear(m, cf.Position)
        end)
        return okc
    end
    if not clearNow() then
        pcall(function()
            local cf = m:GetBoundingBox()
            local away = cf.Position - pos
            away = Vector3.new(away.X, 0, away.Z)
            if away.Magnitude < 0.5 then away = Vector3.new(4, 0, 0) end
            local np = cf.Position + away.Unit * 3
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { lp.Character, m }
            params.IgnoreWater = true
            local hit = Workspace:Raycast(np + Vector3.new(0, 5, 0), Vector3.new(0, -15, 0), params)
            if hit and hit.Position then
                m:PivotTo(CFrame.new(hit.Position + Vector3.new(0, 1.5, 0)))
            end
        end)
        task.wait(0.5)
        if not clearNow() then
            ghostDone[pr] = os.clock() + 60
            tapLog("Ghost", "kein Platz, weiter")
            return
        end
    end
    task.wait(0.5)
    -- Ausstieg mit Retry (max 3x prüfen)
    local outOk = false
    for di = 1, 3 do
        pcall(function() hum.Sit = false end)
        task.wait(0.4)
        pcall(function()
            local ch = lp.Character
            local h2 = ch and ch:FindFirstChildOfClass("Humanoid")
            outOk = h2 and h2.SeatPart == nil
        end)
        if outOk then break end
    end
    if not outOk then tapLog("Ghost", "Ausstieg blockiert!") end
    task.wait(0.6)
    -- Spieler selbst frei? (erst ab 3+ Teilen = wirklich eingebaut; 1 Wand ok)
    local pClear = false
    pcall(function()
        local hrp = myHRP()
        if hrp then
            local op = OverlapParams.new()
            op.FilterType = Enum.RaycastFilterType.Exclude
            op.FilterDescendantsInstances = { lp.Character, m }
            op.MaxParts = 8
            local n = 0
            for _, pt in ipairs(Workspace:GetPartBoundsInBox(CFrame.new(hrp.Position + Vector3.new(0, 0.5, 0)), Vector3.new(2, 2.5, 2), op)) do
                if not isCarPart(pt) then n = n + 1 end
            end
            pClear = n < 3
        end
    end)
    if not pClear then
        tapLog("Ghost", "Spieler im Clip, weiter")
        pcall(function() ghostDone[pr] = os.clock() + 60 end)
        ghostResit()
        task.wait(0.6)
        return
    end
    -- Rest zu Fuß (TP landet max 20m daneben): ran bis 8m ans Fenster
    pcall(function()
        local hrp = myHRP()
        if hrp and (hrp.Position - pos).Magnitude > 8 then
            local ch = lp.Character
            local hum2 = ch and ch:FindFirstChildOfClass("Humanoid")
            if hum2 then
                hum2:MoveTo(pos)
                local t0, n = os.clock(), 0
                while S.ghostFarm and (os.clock() - t0) < 12 do
                    task.wait(0.5)
                    n = n + 1
                    local ok = false
                    pcall(function()
                        local h3 = myHRP()
                        if h3 and (h3.Position - pos).Magnitude <= 8 then ok = true end
                    end)
                    if ok then break end
                    pcall(function()
                        local ch3 = lp.Character
                        local hum3 = ch3 and ch3:FindFirstChildOfClass("Humanoid")
                        if hum3 then
                            if n % 4 == 0 then hum3.Jump = true end
                            hum3:MoveTo(pos)
                        end
                    end)
                end
                pcall(function()
                    local h4 = myHRP()
                    local ch4 = lp.Character
                    local hum4 = ch4 and ch4:FindFirstChildOfClass("Humanoid")
                    if h4 and hum4 then hum4:MoveTo(h4.Position) end
                end)
            end
        end
    end)
    -- Prompt nach Ausstieg noch in Reichweite? sonst gleich wieder einsteigen
    local inRange = false
    pcall(function()
        local hrp = myHRP()
        local maxD = pr.MaxActivationDistance or 12
        if hrp and (hrp.Position - pos).Magnitude <= maxD + 3 then inRange = true end
    end)
    if not inRange then
        tapLog("Ghost", "Spot unerreichbar, weiter")
        pcall(function() ghostDone[pr] = os.clock() + 120 end)
        ghostResit()
        task.wait(0.6)
        return
    end
    local m0 = ghostMoney()
    tapLog("Ghost", "arbeite...")
    local facePart = nil
    pcall(function()
        local hrp = myHRP()
        if hrp then
            local best, bestD = nil, 18
            local bestAny, bestAnyD = nil, 18
            for _, d in ipairs(ghostGlass) do
                local ok = false
                local dd = 1e9
                pcall(function()
                    if d.Parent ~= nil then
                        dd = (hrp.Position - d.Position).Magnitude
                        ok = true
                    end
                end)
                if ok and dd < 18 then
                    if dd < bestAnyD then bestAny, bestAnyD = d, dd end
                    local car = false
                    pcall(function()
                        local p = d.Parent
                        local dep = 0
                        while p and p ~= workspace and dep < 5 do
                            local mn = string.lower(p.Name)
                            if string.find(mn, "car", 1, true) or string.find(mn, "rob", 1, true) or string.find(mn, "vehicle", 1, true) or string.find(mn, "auto", 1, true) then
                                car = true
                                break
                            end
                            if not p:IsA("Model") and not p:IsA("Folder") then break end
                            p = p.Parent
                            dep = dep + 1
                        end
                    end)
                    if car and dd < bestD then best, bestD = d, dd end
                end
            end
            facePart = best or bestAny
            if facePart then
                hrp.CFrame = CFrame.new(hrp.Position, facePart.Position)
                tapLog("Ghost", "Ziel: " .. tostring(facePart.Name))
            else
                tapLog("Ghost", "kein Glas nah!")
            end
        end
    end)
    local fist = equipFist()
    if not fist then tapLog("Ghost", "keine Faust!") end
    local paidEarly = false
    for i = 1, 8 do
        if not S.ghostFarm then break end
        pcall(function() if fist then fist:Activate() end end)
        pcall(function()
            if fireproximityprompt then
                local ok2 = pcall(function() return pr.Parent ~= nil end)
                if ok2 then
                    fireproximityprompt(pr)
                    S.farmed = (S.farmed or 0) + 1
                end
            end
        end)
        brakeScoot()
        if i >= 5 then
            pcall(function()
                local mm = ghostMoney()
                if m0 ~= nil and mm ~= nil and (mm - m0) > 0 then paidEarly = true end
            end)
            if paidEarly then break end
        end
        task.wait(0.45)
    end
    -- Glas wirklich kaputt? Sonst melden (falsches Ziel / zu weit)
    pcall(function()
        if facePart then
            local gone = facePart.Parent == nil
            if not gone then
                pcall(function()
                    if facePart.Transparency >= 0.9 then gone = true end
                end)
            end
            if not gone then tapLog("Ghost", "Glas heil!") end
        else
            tapLog("Ghost", "kein Glas!")
        end
    end)
    pcall(function()
        if fireproximityprompt then
            local hrp = myHRP()
            local myP = hrp and hrp.Position or nil
            if myP then
                for _, pr2 in ipairs(Workspace:GetDescendants()) do
                    if pr2:IsA("ProximityPrompt") and pr2.Parent ~= nil then
                        local t = farmTextOf(pr2)
                        if string.find(t, "take", 1, true) or string.find(t, "collect", 1, true) or string.find(t, "claim", 1, true)
                            or string.find(t, "nehm", 1, true) or string.find(t, "sammel", 1, true) or string.find(t, "abhol", 1, true) then
                            local h2 = farmHost(pr2)
                            local p2 = h2 and h2.Position or nil
                            if p2 and (myP - p2).Magnitude <= 14 then
                                fireproximityprompt(pr2)
                                S.farmed = (S.farmed or 0) + 1
                            end
                        end
                    end
                end
            end
        end
    end)
    task.wait(2)
    do
        local m1 = ghostMoney()
        local function paid()
            ghostFails = 0
            ghostSkips = 0
            ghostPauseUntil = os.clock() + 55
            tapLog("Ghost", "Cooldown = " .. math.floor(ghostPauseUntil - os.clock()) .. "sec")
            pcall(function() ghostDone[pr] = os.clock() + 900 end)
        end
        if m0 ~= nil and m1 ~= nil and (m1 - m0) > 0 then
            paid()
        else
            -- Geld kommt oft spät: 3s nachprüfen bevor trocken gewertet wird
            task.wait(3)
            local m2 = ghostMoney()
            if m0 ~= nil and m2 ~= nil and (m2 - m0) > 0 then
                paid()
            else
                ghostFails = ghostFails + 1
                if ghostFails >= 2 then
                    ghostPauseUntil = os.clock() + 55
                    tapLog("Ghost", "Cooldown = " .. math.floor(ghostPauseUntil - os.clock()) .. "sec")
                end
            end
        end
    end
    pcall(function()
        if (ghostDone[pr] or 0) < os.clock() + 60 then ghostDone[pr] = os.clock() + 180 end
    end)
    ghostResit()
    task.wait(0.6)
end
