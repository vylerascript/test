-- ── KILL ─────────────────────────────────────────────────────────────────────
local function kill()
    for k,c in pairs(conns) do
        if typeof(c)=="RBXScriptConnection" then c:Disconnect() end
        conns[k]=nil
    end
    if mt and orig_idx then
        mt.__index=orig_idx
        pcall(function() setreadonly(mt,true) end)
    end
    for p in pairs(esp_objs) do rm_esp(p) end
    if fov_circle then fov_circle:Remove(); fov_circle=nil end
    apply_invis(false)
    Gui:Destroy()
end

