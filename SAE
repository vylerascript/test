local function make_esp(plr)
    if not Drawing or esp_drawings[plr] then return end
    local box  = Drawing.new("Square")
    box.Visible = false; box.Color = Color3.fromRGB(255,50,50)
    box.Thickness = 1.5; box.Filled = false
    local nm = Drawing.new("Text")
    nm.Visible = false; nm.Color = Color3.fromRGB(255,255,255)
    nm.Size = 13; nm.Outline = true; nm.Center = true
    local hp = Drawing.new("Square")
    hp.Visible = false; hp.Filled = true
    esp_drawings[plr] = {box=box, name=nm, hp=hp}
end

local function rm_esp(plr)
    local d = esp_drawings[plr]; if not d then return end
    d.box:Remove(); d.name:Remove(); d.hp:Remove()
    esp_drawings[plr] = nil
end

connections["esp"] = RunService.RenderStepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            make_esp(plr)
            local d = esp_drawings[plr]; if not d then continue end
            local hum  = get_hum_p(plr)
            local root = get_root_p(plr)
            if not cfg.esp or not root or not hum or hum.Health <= 0 then
                d.box.Visible=false; d.name.Visible=false; d.hp.Visible=false; continue
            end
            local ts, on_t = world_to_vp(root.Position + Vector3.new(0,3,0))
            local bs, on_b = world_to_vp(root.Position - Vector3.new(0,3,0))
            if not on_t and not on_b then
                d.box.Visible=false; d.name.Visible=false; d.hp.Visible=false; continue
            end
            local h  = math.abs(ts.Y - bs.Y)
            local w  = h * 0.5
            local x  = ts.X - w/2
            d.box.Position = Vector2.new(x, ts.Y)
            d.box.Size     = Vector2.new(w, h)
            d.box.Visible  = true
            d.name.Text     = plr.Name
            d.name.Position = Vector2.new(ts.X, ts.Y - 16)
            d.name.Visible  = true
            local frac = hum.Health / hum.MaxHealth
            local hh   = h * frac
            d.hp.Position = Vector2.new(x - 6, ts.Y + (h - hh))
            d.hp.Size     = Vector2.new(3, hh)
            d.hp.Color    = Color3.fromRGB(math.floor(255*(1-frac)), math.floor(255*frac), 0)
            d.hp.Visible  = true
        end
    end
end)

