local function sweepGui()
    local names = { "SLR_GUI", "SLR_FOV", "SLR_2D", "SLR_Touch", "SLR_PDUMP", "SLR_LOG", "MINI", "MINI_T", "HITB", "SL_UI", "SLR_DBG_GUI", "SLR_ESP" }
    local roots = { root }
    pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
    pcall(function()
        local pg = lp:FindFirstChildOfClass("PlayerGui")
        if pg and pg ~= root then table.insert(roots, pg) end
    end)
    for _, r in ipairs(roots) do
        for _, n in ipairs(names) do
            pcall(function() local o = r:FindFirstChild(n) if o then o:Destroy() end end)
        end
    end
end
