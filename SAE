-- Silent-Install async (blockiert Start nie)
S.silent = false
local function silentTarget()
    local camNow = Workspace.CurrentCamera
    if not camNow then return nil end
    local vs = camNow.ViewportSize
    local mp = vs / 2
    local me = myHRP()
    local myPos = me and me.Position or nil
    local function okHead(p, tp)
        if not tp then return false end
        if myPos and (myPos - tp.Position).Magnitude > S.aimMaxDist then return false end
        if S.wallCheck and shared.blocked and shared.blocked[p] then return false end
        local v, on = camNow:WorldToViewportPoint(tp.Position)
        if not on then return false end
        return true, (Vector2.new(v.X, v.Y) - mp).Magnitude
    end
    -- Blick-Lock: Nächster an Bildmitte; Wechsel nur bei klarem Sieger (35px)
    local best, bestD, bestP = nil, S.aimFOV, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local tp = targetHead(p)
            local ok, d = okHead(p, tp)
            if ok and d < bestD then best, bestD, bestP = tp, d, p end
        end
    end
    if best then
        pcall(function()
            local lp2 = shared.locked
            if lp2 and lp2 ~= bestP then
                local tp2 = targetHead(lp2)
                local ok2, d2 = okHead(lp2, tp2)
                if ok2 and d2 < S.aimFOV and d2 <= bestD + 35 then
                    best, bestD, bestP = tp2, d2, lp2
                end
            end
        end)
    end
    if bestP then
        shared.locked = bestP
        shared.lockT = os.clock()
    else
        -- Gnadenfrist 0.35s: letztes Ziel halten (kurz hinter Wand/am Rand)
        local keep = false
        pcall(function()
            local lp2 = shared.locked
            if lp2 and shared.lockT and (os.clock() - shared.lockT) < 0.35 then
                local tp2 = targetHead(lp2)
                if tp2 then
                    local camNow = Workspace.CurrentCamera
                    local v, on = camNow:WorldToViewportPoint(tp2.Position)
                    if on then keep = true best = tp2 end
                end
            end
        end)
        if not keep then shared.locked = nil end
    end
    return best
end
local function silentHold()
    if S.immer then return true end
    if S.touchHold then return true end
    return S.bindHeld
end
shared.silentTarget = silentTarget
shared.silentHold = silentHold
task.spawn(function()
    local Projectile = nil
    for i = 1, 30 do
        if shared.silentInstalled then return end
        pcall(function()
            local mod = game:GetService("ReplicatedStorage").Modules.GunFramework.Modules.Projectile
            if mod then
                local P = require(mod)
                if P and P.new then Projectile = P end
            end
        end)
        if Projectile then break end
        task.wait(1)
    end
    if shared.silentInstalled then return end
    if not (Projectile and Projectile.new) then warn("[SLR] Silent: Modul fehlt") return end
    shared.silentMod = Projectile
    shared.silentOrig = Projectile.new
    Projectile.new = function(params)
        pcall(function()
            shared.silentCalls = (shared.silentCalls or 0) + 1
            local st = shared.S
            if st and st.silent and params and params.Origin and params.Direction and shared.silentHold() then
                local head = nil
                if shared.silentCache and shared.silentCacheT and (os.clock() - shared.silentCacheT) < 0.2 then
                    pcall(function()
                        local ch = shared.silentCache.Parent
                        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then head = shared.silentCache end
                    end)
                end
                if not head then head = shared.silentTarget() end
                if head then
                    local aimP = head.Position
                    pcall(function()
                        local ch = head.Parent
                        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                        if hrp then
                            local dist = (aimP - params.Origin).Magnitude
                            -- Laufrichtung statt Ruckel-Velocity + halber Ping
                            local vel = hrp.Velocity
                            if hum then
                                pcall(function()
                                    local md = hum.MoveDirection
                                    if md.Magnitude > 0.1 then
                                        vel = md * hum.WalkSpeed
                                    else
                                        vel = Vector3.zero
                                    end
                                end)
                            end
                            local ping = 0
                            pcall(function() ping = lp:GetNetworkPing() or 0 end)
                            local lead = vel * (math.clamp(dist / 900, 0, 0.6) + ping / 2)
                            if lead.Magnitude > 25 then lead = lead.Unit * 25 end
                            aimP = aimP + lead
                        end
                    end)
                    -- Winkel merken (Diagnose im Status)
                    pcall(function()
                        local camNow = Workspace.CurrentCamera
                        if camNow then
                            local look = camNow.CFrame.LookVector
                            local dir = (aimP - camNow.CFrame.Position).Unit
                            local dot = math.clamp(look.X * dir.X + look.Y * dir.Y + look.Z * dir.Z, -1, 1)
                            shared.silentAng = math.floor(math.deg(math.acos(dot)))
                        end
                    end)
                    -- First-Shot-Diagnose: alle params-Felder einmalig loggen
                    if not shared.silentLogged then
                        shared.silentLogged = true
                        pcall(function()
                            local parts = { "[SLR-PARAMS]" }
                            if type(params) == "table" then
                                for k, v in pairs(params) do
                                    table.insert(parts, tostring(k) .. " (" .. type(v) .. ")")
                                end
                            end
                            local msg = table.concat(parts, " | ")
                            warn(msg)
                            if setclipboard then setclipboard(msg) end
                        end)
                    end
                    -- Kopf-Sanity: Höhe über HRP prüfen (Stream-Leichen?), sonst HRP+2
                    pcall(function()
                        local ch = head.Parent
                        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local dy = head.Position.Y - hrp.Position.Y
                            if dy < 0.5 or dy > 4 then
                                aimP = hrp.Position + Vector3.new(0, 2, 0)
                            end
                        end
                    end)
                    -- Mündungs-Sichtlinie: Wand zwischen Mündung und Ziel? -> nicht umlenken
                    local clearShot = false
                    pcall(function()
                        local ch = head.Parent
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        rp.FilterDescendantsInstances = { lp.Character, ch }
                        rp.IgnoreWater = true
                        local hit = Workspace:Raycast(params.Origin, aimP - params.Origin, rp)
                        if not hit then
                            clearShot = true
                        else
                            pcall(function()
                                if hit.Instance and hit.Instance:IsDescendantOf(ch) then clearShot = true end
                            end)
                        end
                    end)
                    if not clearShot then return end
                    -- Origin an Kamera angleichen (kohärent mit Direction) + Range auf
                    pcall(function()
                        local camNow = Workspace.CurrentCamera
                        if camNow then
                            params.Origin = camNow.CFrame.Position
                        end
                        if params.MaxDistance ~= nil then params.MaxDistance = 9999 end
                        if params.Range ~= nil then params.Range = 9999 end
                    end)
                    params.Direction = (aimP - params.Origin).Unit
                    local plr = head.Parent and game:GetService("Players"):GetPlayerFromCharacter(head.Parent)
                    if plr then shared.locked = plr end
                end
            end
        end)
        return shared.silentOrig(params)
    end
    shared.silentInstalled = true
    warn("[SLR] Silent Aim bereit.")
end)

