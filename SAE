local function box2dTick()
    if not gui2d then return end
    local camNow = Workspace.CurrentCamera
    if not camNow then return end
    local me = myHRP()
    local myPos = me and me.Position or nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then
            box2dHide(p)
        else
            local ok = pcall(function()
                local ch = p.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                if not (S.box2d and hum and hrp and hum.Health > 0) then box2dHide(p) return end
                if myPos and (myPos - hrp.Position).Magnitude > S.espMaxDist then box2dHide(p) return end
                local cf, sz = ch:GetBoundingBox()
                local minX, minY, maxX, maxY, any = 1e9, 1e9, -1e9, -1e9, false
                for xi = -1, 1, 2 do for yi = -1, 1, 2 do for zi = -1, 1, 2 do
                    local wp = (cf * CFrame.new(xi * sz.X / 2, yi * sz.Y / 2, zi * sz.Z / 2)).Position
                    local v, on = camNow:WorldToViewportPoint(wp)
                    if on then
                        any = true
                        if v.X < minX then minX = v.X end
                        if v.Y < minY then minY = v.Y end
                        if v.X > maxX then maxX = v.X end
                        if v.Y > maxY then maxY = v.Y end
                    end
                end end end
                if not any or (maxX - minX) < 4 or (maxY - minY) < 4 then box2dHide(p) return end
                local f = box2dSet(p)
                local gun = playerGun(p)
                local armed = gun ~= nil
                local blk = shared.blocked and shared.blocked[p]
                local col = (shared.locked == p) and Color3.fromRGB(255, 255, 255)
                    or (blk and WALL_RED)
                    or (armed and Color3.fromRGB(255, 150, 40) or S.boxColor)
                local t = 2
                local w, h = maxX - minX, maxY - minY
                local function put(n, x, y, sx, sy, c)
                    local fr = f:FindFirstChild(n)
                    if fr then
                        fr.Position = UDim2.new(0, x, 0, y)
                        fr.Size = UDim2.new(0, sx, 0, sy)
                        fr.BackgroundColor3 = c or col
                        fr.Visible = true
                    end
                end
                put("T", minX, minY, w, t)
                put("B", minX, maxY - t, w, t)
                put("L", minX, minY, t, h)
                put("R", maxX - t, minY, t, h)
                local frac = math.clamp(hum.Health / (hum.MaxHealth > 0 and hum.MaxHealth or 100), 0, 1)
                local hpc = frac > 0.5 and Color3.fromRGB(0, 220, 100)
                    or (frac > 0.25 and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(255, 50, 50))
                put("HPBG", minX - 7, minY, 4, h, Color3.fromRGB(20, 20, 20))
                local fh = h * frac
                put("HP", minX - 7, maxY - fh, 4, fh, hpc)
            end)
            if not ok then box2dHide(p) end
        end
    end
    for plr, f in pairs(box2dCache) do
        if not f.Parent or not plr.Parent then box2dCache[plr] = nil pcall(function() f:Destroy() end) end
    end
end
