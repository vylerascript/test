local function mkSlider(parent, y, label, min, max, step, get, set, fmt)
    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1, -20, 0, 48)
    wrap.Position = UDim2.new(0, 10, 0, y)
    wrap.BackgroundTransparency = 1
    wrap.Parent = parent
    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.new(0.65, 0, 0, 16)
    lab.BackgroundTransparency = 1
    lab.Text = label
    lab.TextSize = 12
    lab.TextXAlignment = Enum.TextXAlignment.Left
    lab.TextColor3 = DIM
    lab.Parent = wrap
    local val = Instance.new("TextLabel")
    val.Size = UDim2.new(0.35, 0, 0, 16)
    val.Position = UDim2.new(0.65, 0, 0, 0)
    val.BackgroundTransparency = 1
    val.TextSize = 12
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.TextColor3 = TXT
    val.Parent = wrap
    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, 0, 0, 22)
    track.Position = UDim2.new(0, 0, 0, 20)
    track.BackgroundTransparency = 1
    track.Text = ""
    track.Parent = wrap
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, 0, 0, 5)
    bar.Position = UDim2.new(0, 0, 0.5, -2)
    bar.BackgroundColor3 = CARD2
    bar.BorderSizePixel = 0
    local barc = Instance.new("UICorner")
    barc.CornerRadius = UDim.new(1, 0)
    barc.Parent = bar
    bar.Parent = track
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = ACC
    fill.BorderSizePixel = 0
    local fillc = Instance.new("UICorner")
    fillc.CornerRadius = UDim.new(1, 0)
    fillc.Parent = fill
    fill.Parent = bar
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 13, 0, 13)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    local knobc = Instance.new("UICorner")
    knobc.CornerRadius = UDim.new(1, 0)
    knobc.Parent = knob
    knob.Parent = bar
    local function render()
        local v = get()
        local f = (max > min) and math.clamp((v - min) / (max - min), 0, 1) or 0
        val.Text = fmt(v)
        fill.Size = UDim2.new(f, 0, 1, 0)
        knob.Position = UDim2.new(f, -6, 0.5, -6)
    end
    local dragging = false
    local function applyX(x)
        local p = track.AbsolutePosition.X
        local w = math.max(track.AbsoluteSize.X, 1)
        local f = math.clamp((x - p) / w, 0, 1)
        local stepped = math.floor((min + f * (max - min)) / step + 0.5) * step
        set(math.clamp(stepped, min, max))
        render()
    end
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            applyX(inp.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            applyX(inp.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    render()
    return wrap
end

local function mkDotsRow(parent, y, getName, onPick)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -20, 0, 24)
    row.Position = UDim2.new(0, 10, 0, y)
    row.BackgroundTransparency = 1
    row.Parent = parent
    local dots = {}
    for i, e in ipairs(ESP_COLORS) do
        local d = Instance.new("TextButton")
        d.Size = UDim2.new(0, 22, 0, 22)
        d.Position = UDim2.new(0, (i - 1) * 25, 0, 1)
        d.Text = ""
        d.BackgroundColor3 = e.c
        d.BorderSizePixel = 0
        local dc = Instance.new("UICorner")
        dc.CornerRadius = UDim.new(1, 0)
        dc.Parent = d
        local ring = Instance.new("UIStroke")
        ring.Thickness = 2
        ring.Color = Color3.fromRGB(255, 255, 255)
        ring.Transparency = 1
        ring.Parent = d
        d.Parent = row
        d.Activated:Connect(function()
            onPick(e)
            for _, o in ipairs(dots) do
                o.ring.Transparency = (o.e.n == e.n) and 0 or 1
            end
            tapLog("Color", e.n)
        end)
        table.insert(dots, { e = e, ring = ring })
    end
    for _, o in ipairs(dots) do
        o.ring.Transparency = (o.e.n == getName()) and 0 or 1
    end
    return row
end

