-- ── KILL ─────────────────────────────────────────────────────────────────────
local function kill()
    for k, c in pairs(connections) do
        if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
        connections[k] = nil
    end
    if mt and orig_index then
        mt.__index = orig_index
        pcall(function() setreadonly(mt, true) end)
    end
    for plr in pairs(esp_drawings) do rm_esp(plr) end
    if fov_circle then fov_circle:Remove(); fov_circle = nil end
    apply_invis(false)
    -- restore TakeDamage
    local hum = get_hum()
    if hum then
        local h2 = get_hum()
        if h2 then pcall(function() h2.Health = h2.MaxHealth end) end
    end
    Gui:Destroy()
end

