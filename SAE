-- ── UTILS ────────────────────────────────────────────────────────────────────
local function gchar()    return lp.Character end
local function groot()    local c=gchar() return c and c:FindFirstChild("HumanoidRootPart") end
local function ghum()     local c=gchar() return c and c:FindFirstChildOfClass("Humanoid") end
local function phead(p)   local c=p.Character return c and c:FindFirstChild("Head") end
local function phum(p)    local c=p.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function proot(p)   local c=p.Character return c and c:FindFirstChild("HumanoidRootPart") end

local function w2v(pos)
    local s, on = cam:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), on
end

-- ── SILENT AIM ───────────────────────────────────────────────────────────────
local function best_target()
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local bd, bp = cfg.silent_fov, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local h = phead(p)
            local hu = phum(p)
            if h and hu and hu.Health > 0 then
                local s, on = w2v(h.Position)
                if on then
                    local d = (s - center).Magnitude
                    if d < bd then bd=d; bp=p end
                end
            end
        end
    end
    return bp
end

local mt = getrawmetatable and getrawmetatable(mouse)
local orig_idx
if mt then
    setreadonly(mt, false)
    orig_idx = mt.__index
    mt.__index = function(self, key)
        if cfg.silent_aim and (key=="Hit" or key=="Target") then
            local t = best_target()
            if t then
                local h = phead(t)
                if h then
                    if key=="Hit"    then return CFrame.new(h.Position) end
                    if key=="Target" then return h end
                end
            end
        end
        return orig_idx(self, key)
    end
end

