local function ghostSideLanding(m, pr, pos)
    local ccf = nil
    pcall(function()
        local host = farmHost(pr)
        local carM, p, depth = nil, host and host.Parent or nil, 0
        while p and p ~= workspace and depth < 4 do
            if p:IsA("Model") then carM = p end
            p = p.Parent
            depth = depth + 1
        end
        if carM then
            local c, s = carM:GetBoundingBox()
            if (c.Position - pos).Magnitude <= (s.Magnitude / 2 + 3) then ccf = c end
        end
    end)
    if not ccf then return nil end
    local dir = Vector3.new(pos.X - ccf.Position.X, 0, pos.Z - ccf.Position.Z)
    if dir.Magnitude < 0.5 then return nil end
    dir = dir.Unit
    local target = pos + dir * 2.6
    local gy = nil
