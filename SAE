        if hit and hit.Position and not isCarPart(hit.Instance) then
            gy = hit.Position.Y
        end
    end)
    if not gy then return nil end
    local _, yaw, _ = ccf:ToOrientation()
    return CFrame.new(target.X, gy + 1, target.Z) * CFrame.Angles(0, yaw, 0)
