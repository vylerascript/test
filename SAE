-- ── ESP ──────────────────────────────────────────────────────────────────────
local function make_esp(plr)
    if not Drawing or esp_objs[plr] then return end
    local box = Drawing.new("Square")
    box.Visible=false; box.Color=Color3.fromRGB(255,50,50); box.Thickness=1.5; box.Filled=false
    local nm  = Drawing.new("Text")
    nm.Visible=false; nm.Color=Color3.fromRGB(255,255,255); nm.Size=13; nm.Outline=true; nm.Center=true
    local hp  = Drawing.new("Square")
    hp.Visible=false; hp.Filled=true
    esp_objs[plr] = {box=box,name=nm,hp=hp}
end

local function rm_esp(plr)
    local d = esp_objs[plr]
    if not d then return end
    d.box:Remove(); d.name:Remove(); d.hp:Remove()
    esp_objs[plr] = nil
end

conns.esp = RunService.RenderStepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            make_esp(plr)
            local d  = esp_objs[plr]
            local hu = phum(plr)
            local rt = proot(plr)
            if not d then
                -- nothing
            elseif not cfg.esp or not rt or not hu or hu.Health<=0 then
                d.box.Visible=false; d.name.Visible=false; d.hp.Visible=false
            else
                local ts,ot = w2v(rt.Position+Vector3.new(0,3,0))
                local bs,ob = w2v(rt.Position-Vector3.new(0,3,0))
                if not ot and not ob then
                    d.box.Visible=false; d.name.Visible=false; d.hp.Visible=false
                else
                    local hh = math.abs(ts.Y-bs.Y)
                    local ww = hh*0.5
                    local xx = ts.X-ww/2
                    d.box.Position=Vector2.new(xx,ts.Y); d.box.Size=Vector2.new(ww,hh); d.box.Visible=true
                    d.name.Text=plr.Name; d.name.Position=Vector2.new(ts.X,ts.Y-16); d.name.Visible=true
                    local fr = hu.Health/hu.MaxHealth
                    local bh = hh*fr
                    d.hp.Position=Vector2.new(xx-6,ts.Y+(hh-bh)); d.hp.Size=Vector2.new(3,bh)
                    d.hp.Color=Color3.fromRGB(math.floor(255*(1-fr)),math.floor(255*fr),0)
                    d.hp.Visible=true
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(rm_esp)

-- ── CAR LOOT FARM ────────────────────────────────────────────────────────────
local function find_loot_remote()
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if (v:IsA("RemoteEvent") or v:IsA("RemoteFunction")) then
            local n = v.Name:lower()
            if n:find("loot") or n:find("rob") or n:find("money")
            or n:find("steal") or n:find("cash") or n:find("collect") then
                return v
            end
        end
    end
end

local function do_car_loot()
    if farm_active then return end
    farm_active = true
    local ok, err = pcall(function()
        local root = groot()
        if not root then return end
        local remote = find_loot_remote()

        for _, obj in ipairs(workspace:GetDescendants()) do
            if not cfg.autofarm then break end
            local seat = nil
            if obj:IsA("VehicleSeat") or obj:IsA("Seat") then
                seat = obj
            elseif obj:IsA("Model") then
                local n = obj.Name:lower()
                if n:find("car") or n:find("vehicle") or n:find("auto") then
                    seat = obj:FindFirstChildOfClass("VehicleSeat")
                       or obj:FindFirstChildOfClass("Seat")
                end
            end

            if seat then
                -- tween to seat, never raw TP
                local tw = TweenService:Create(root,
                    TweenInfo.new(0.4, Enum.EasingStyle.Linear),
                    {CFrame = seat.CFrame * CFrame.new(0,2,0)})
                tw:Play(); tw.Completed:Wait()

                -- spoof sit
                local hu = ghum()
                if hu and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
                    seat:Sit(hu)
                    task.wait(0.25)
                end

                -- prox prompts on car
                local parent = seat.Parent or seat
                for _, pp in ipairs(parent:GetDescendants()) do
                    if pp:IsA("ProximityPrompt") then
                        pcall(fireproximityprompt, pp)
                    end
                end

                -- loot remote
                if remote then
                    if remote:IsA("RemoteEvent") then
                        pcall(function() remote:FireServer(parent) end)
                    else
                        pcall(function() remote:InvokeServer(parent) end)
                    end
                end

                task.wait(0.5)
                local hu2 = ghum()
                if hu2 then pcall(function() hu2.Sit = false end) end

                -- nearby prox prompts
                local rt2 = groot()
                if rt2 then
                    for _, pp in ipairs(workspace:GetDescendants()) do
                        if pp:IsA("ProximityPrompt") then
                            local pt = pp.Parent
                            if pt and pt:IsA("BasePart") then
                                if (rt2.Position-pt.Position).Magnitude < 30 then
                                    pcall(fireproximityprompt, pp)
                                end
                            end
                        end
                    end
                end
                task.wait(0.4)
            end
        end
    end)
    if not ok then warn("farm err: "..tostring(err)) end
    farm_active = false
end

local farm_timer = 0
conns.farm = RunService.Heartbeat:Connect(function(dt)
    if not cfg.autofarm then farm_timer=0; return end
    farm_timer = farm_timer + dt
    if farm_timer >= 3 then
        farm_timer = 0
        task.spawn(do_car_loot) -- spawn so Heartbeat never yields
    end
end)

-- ── INVIS ────────────────────────────────────────────────────────────────────
local function apply_invis(state)
    local c = gchar()
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.LocalTransparencyModifier = state and 1 or 0
            pcall(function() p.Transparency = state and 1 or 0 end)
        end
        if p:IsA("Decal") or p:IsA("SpecialMesh") then
            pcall(function() p.Transparency = state and 1 or 0 end)
        end
    end
    local hu = ghum()
    if hu then
        pcall(function()
            hu.DisplayDistanceType = state
                and Enum.HumanoidDisplayDistanceType.None
                or  Enum.HumanoidDisplayDistanceType.Viewer
        end)
    end
end

conns.invis_spawn = lp.CharacterAdded:Connect(function()
    task.wait(1)
    if cfg.invis   then apply_invis(true) end
    if cfg.godmode then
        local hu = ghum()
        if hu then pcall(function() hu.Health = hu.MaxHealth end) end
    end
end)

-- ── GODMODE ──────────────────────────────────────────────────────────────────
local function hook_gm()
    local hu = ghum(); if not hu then return end
    local old_td = hu.TakeDamage
    hu.TakeDamage = function(self, amt)
        if cfg.godmode then return end
        return old_td(self, amt)
    end
    conns.gm_hc = hu.HealthChanged:Connect(function(hp)
        if cfg.godmode and hp < hu.MaxHealth then
            pcall(function() hu.Health = hu.MaxHealth end)
        end
    end)
end

hook_gm()
conns.gm_spawn = lp.CharacterAdded:Connect(function()
    task.wait(0.5); hook_gm()
end)

local gm_t = 0
conns.gm_beat = RunService.Heartbeat:Connect(function(dt)
    if not cfg.godmode then return end
    gm_t = gm_t + dt
    if gm_t < 0.1 then return end
    gm_t = 0
    local hu = ghum()
    if hu and hu.Health < hu.MaxHealth then
        pcall(function() hu.Health = hu.MaxHealth end)
    end
end)

