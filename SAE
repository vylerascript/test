                    local v, on = camNow:WorldToViewportPoint(tp.Position)
                    if on then
                        local d = (Vector2.new(v.X, v.Y) - mp).Magnitude
                        if d < bestD then best, bestD = tp, d end
                    end
                end
            end
        end
