local function ghostLanding(pos, ignore)
    local best, bestScore = nil, 1e9
    for _, r in ipairs({ 2.6, 4.5, 6.5 }) do
        local q = r * 0.7
        for _, off in ipairs({ Vector3.new(r, 1, 0), Vector3.new(-r, 1, 0), Vector3.new(0, 1, r), Vector3.new(0, 1, -r), Vector3.new(q, 1, q), Vector3.new(-q, 1, q), Vector3.new(q, 1, -q), Vector3.new(-q, 1, -q) }) do
            local cand = pos + off
        local ok, hit = pcall(function()
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = ignore or {}
            params.IgnoreWater = true
            return Workspace:Raycast(cand + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), params)
        end)
        if ok and hit and hit.Position and hit.Instance then
            if isCarPart(hit.Instance) then continue end
            local drop = cand.Y - hit.Position.Y
            if drop >= 1.5 and drop <= 7 then
                -- Freiraum NUR auf Roller-Höhe (Boden zählt nicht!), Auto egal
                local free = false
                pcall(function()
                    local op = OverlapParams.new()
                    op.FilterType = Enum.RaycastFilterType.Exclude
                    op.FilterDescendantsInstances = ignore or {}
                    op.MaxParts = 20
                    local parts = Workspace:GetPartBoundsInBox(CFrame.new(cand + Vector3.new(0, 1.5, 0)), Vector3.new(4, 2.5, 4), op)
                    free = true
                    for _, pt in ipairs(parts) do
                        if not isCarPart(pt) then free = false break end
                    end
                end)
                if free then
                    -- offene Seite bevorzugt (Wandnähe = Stuck-Risiko)
                    local open = 0
                    pcall(function()
                        for _, dd in ipairs({ Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0), Vector3.new(0, 0, 4), Vector3.new(0, 0, -4) }) do
                            local params2 = RaycastParams.new()
                            params2.FilterType = Enum.RaycastFilterType.Exclude
                            params2.FilterDescendantsInstances = ignore or {}
                            params2.IgnoreWater = true
                            local h2 = Workspace:Raycast(cand + Vector3.new(0, 1.5, 0), dd, params2)
                            if not (h2 and h2.Instance and not isCarPart(h2.Instance)) then open = open + 1 end
                        end
                    end)
                    local score = drop + (cand - pos).Magnitude * 0.1 - open * 2
                    if score < bestScore then best, bestScore = cand, score end
                end
            end
        end
    end
    end
    return best or (pos + Vector3.new(0, 2, 4))
end
