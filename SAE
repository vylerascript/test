    local camNow = Workspace.CurrentCamera
    if not camNow then return nil end
    local vs = camNow.ViewportSize
    local mok, m = pcall(function() return UIS:GetMouseLocation() end)
    local mp = (mok and m) or (vs / 2)
    local best, bestD = nil, S.aimFOV
