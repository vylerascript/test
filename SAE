local function make_toggle(lbl, key, cb)
    order=order+1
    local R=Instance.new("Frame",Scroll)
    R.Size=UDim2.new(1,0,0,38); R.BackgroundColor3=Color3.fromRGB(20,20,30)
    R.BorderSizePixel=0; R.LayoutOrder=order
    Instance.new("UICorner",R).CornerRadius=UDim.new(0,7)
    local L=Instance.new("TextLabel",R)
    L.Size=UDim2.new(1,-58,1,0); L.Position=UDim2.new(0,12,0,0)
    L.BackgroundTransparency=1; L.TextColor3=Color3.fromRGB(200,200,215)
    L.Font=Enum.Font.Gotham; L.TextSize=12
    L.TextXAlignment=Enum.TextXAlignment.Left; L.Text=lbl
    local K=Instance.new("Frame",R)
    K.Size=UDim2.new(0,42,0,22); K.Position=UDim2.new(1,-50,0.5,-11)
    K.BackgroundColor3=cfg[key] and CON or COFF; K.BorderSizePixel=0
    Instance.new("UICorner",K).CornerRadius=UDim.new(0,11)
    local P=Instance.new("Frame",K)
    P.Size=UDim2.new(0,18,0,18)
    P.Position=cfg[key] and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)
    P.BackgroundColor3=Color3.fromRGB(255,255,255); P.BorderSizePixel=0
    Instance.new("UICorner",P).CornerRadius=UDim.new(0,9)
    local function ref()
        local on=cfg[key]
        TweenService:Create(K,TweenInfo.new(0.12),{BackgroundColor3=on and CON or COFF}):Play()
        TweenService:Create(P,TweenInfo.new(0.12),{
            Position=on and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9)}):Play()
    end
    R.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            cfg[key]=not cfg[key]; ref()
            if cb then cb(cfg[key]) end
        end
    end)
end

