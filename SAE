local robCache = {}
local ROB_KEYS = { "rob", "safe", "vault", "register", "cash", "loot", "steal", "hack", "crack", "drill" }
local function robText(prompt)
    local a, o = "", ""
    pcall(function() a = tostring(prompt.ActionText or "") end)
    pcall(function() o = tostring(prompt.ObjectText or "") end)
    if a ~= "" then return a end
    return o
end
local function robScan()
    local found = {}
    pcall(function()
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local t = string.lower(robText(d))
                if t ~= "" then
                    for _, k in ipairs(ROB_KEYS) do
                        if string.find(t, k, 1, true) then
                            table.insert(found, d)
                            break
                        end
                    end
                end
            end
            if #found >= 60 then break end
        end
    end)
    return found
end
local function robTag(prompt, dist)
    local host = prompt.Parent
    if host and not host:IsA("BasePart") then
        host = prompt:FindFirstAncestorOfClass("BasePart")
    end
    if not (host and host:IsA("BasePart")) then return end
    local b = host:FindFirstChild("SLR_Rob")
    if b and b.Size.X.Offset ~= 84 then b:Destroy() b = nil end
    if not b then
        b = Instance.new("BillboardGui")
        b.Name = "SLR_Rob"
        b.Size = UDim2.new(0, 84, 0, 18)
        b.StudsOffset = Vector3.new(0, 1.6, 0)
        b.AlwaysOnTop = true
        local t = Instance.new("TextLabel")
        t.Name = "T"
        t.Size = UDim2.new(1, 0, 1, 0)
        t.BackgroundTransparency = 1
        t.TextScaled = true
        t.TextStrokeTransparency = 0
        t.TextXAlignment = Enum.TextXAlignment.Center
        t.TextColor3 = Color3.fromRGB(255, 210, 80)
        t.Parent = b
        b.Parent = host
    end
    local t = b:FindFirstChild("T")
    if t then t.Text = robText(prompt) .. " " .. math.floor(dist) .. "m" end
end
local function clearRob()
    for prompt, _ in pairs(robCache) do
        pcall(function()
            local host = prompt.Parent
            if host and not host:IsA("BasePart") then
                host = prompt:FindFirstAncestorOfClass("BasePart")
            end
            local b = host and host:FindFirstChild("SLR_Rob")
            if b then b:Destroy() end
        end)
    end
    robCache = {}
end
